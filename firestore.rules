rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'anna.railton@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /jobs/{jobId} {
      function validJob() {
        let data = request.resource.data;
        let fields = ['task', 'category', 'deadline', 'submittedAt', 'status', 'sentAt', 'error', 'reprintOf'];
        return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
          && data.task is string && data.task.size() > 0 && data.task.size() <= 1000
          && data.task.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && data.category in [null, 'Council', 'Work', 'Life admin']
          && (data.deadline == null || (data.deadline is string
            && data.deadline.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')))
          && data.submittedAt == request.time
          && data.status == 'queued' && data.sentAt == null && data.error == null
          && data.reprintOf == null;
      }

      allow read: if isOwner();
      allow create: if isOwner() && validJob();
      // Reprint resets the existing job; ticket contents and submission date stay fixed.
      // Do not reset a job while the Pi is actively sending it.
      allow update: if isOwner()
        && resource.data.status in ['queued', 'sent', 'failed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sentAt', 'error'])
        && request.resource.data.status == 'queued'
        && request.resource.data.sentAt == null && request.resource.data.error == null;
      allow delete: if false;
    }
    match /printers/{printerId} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
